pipeline {
    agent any

    tools {
        maven "My Maven"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/HarikrishnaPeram/Devops_Practice.git'
            }
        }

        stage('Check Files') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'find . -type f'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t myfirstimage .'
            }
        }

        stage('container') {
            steps {
                sh'docker rm -f container1 || true'

               sh 'docker run -d -p 1111:80 --name container1 myfirstimage'
            }
        }
    }
}
